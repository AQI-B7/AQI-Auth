# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://auth:auth_secret@localhost:5432/auth_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_MEMORY_COST=65536
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional - for production use real SMTP)
# Leave SMTP_HOST empty to run in dev mode: magic-link / reset / invite
# emails are logged instead of sent, and their token is echoed back in
# the API response (never in production, regardless of this setting).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Auth Service <noreply@example.com>"

# Frontend (where OAuth callbacks and emailed links redirect/point to)
FRONTEND_URL=http://localhost:3000

# ── OAuth — Google (optional). Leave both empty to disable this login
# method entirely; no route is broken by omitting it, it simply 404s.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/oauth/google/callback

# ── OAuth — GitHub (optional). Same rules as Google above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/v1/auth/oauth/github/callback

# 32-byte key (hex or base64) used to encrypt OAuth provider tokens at
# rest. Generate with: openssl rand -hex 32
# If unset, falls back to deriving a key from JWT_ACCESS_SECRET in
# non-production only — set this explicitly in production.
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Outgoing webhooks (optional). Requires Redis (already a hard
# dependency of this service). Set to false to fully disable the
# delivery queue/worker, e.g. in a Redis-less environment.
WEBHOOKS_ENABLED=true
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# Magic link (passwordless login)
MAGIC_LINK_TTL_MINUTES=15

# Account lockout (progressive delay after repeated failed logins)
LOCKOUT_MAX_ATTEMPTS=5

# Structured logging
LOG_LEVEL=info

# Prometheus metrics (GET /v1/metrics). Leave blank only if the scrape
# path is already restricted at the network layer.
METRICS_TOKEN=

# OpenTelemetry tracing (optional — off by default)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=standalone-auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Branding (used in emails)
BRAND_NAME="Auth Service"
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=#4f46e5
BRAND_SUPPORT_EMAIL=
DEFAULT_LOCALE=en

# Ops alerting for dead-lettered webhook deliveries (optional)
WEBHOOK_ALERTS_ENABLED=true
OPS_ALERT_WEBHOOK_URL=

# Secrets management (optional). SECRETS_PROVIDER=env (default) reads
# secrets from this file / process.env as normal; vault/aws fetch and
# merge additional values into process.env at boot.
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=
AWS_REGION=us-east-1
AWS_SECRET_ID=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=20
